# Default experience works offline from external commerce providers.
SHOPIFY_LIVE=false

# Public HTTPS agent profile. A RoomReady deployment serves /.well-known/ucp.
SHOPIFY_UCP_PROFILE_URL=

# Optional for public catalog discovery. Required for authenticated checkout creation.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional for local tests. Set to your own public IP. Vercel uses its verified forwarding header.
SHOPIFY_BUYER_IP=

# Comma-separated custom storefront hostnames where you have verified Shopify UCP support.
# Standard *.myshopify.com storefronts are supported by default.
SHOPIFY_MERCHANT_DOMAINS=

# Optional visual design assistance in Live Shopify mode.
# ROOMREADY_AI_PROVIDER=openai
# ROOMREADY_AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
